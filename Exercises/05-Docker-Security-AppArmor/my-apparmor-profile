
#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected,mediate_deleted) {
	# Allow container lifecycle signals needed by Docker
	signal (receive) set=(term, kill) peer=unconfined,
	signal (send, receive) set=(term, kill) peer=unconfined,  
  # Allow access to the root directory
    / r,

    # Application directory
    /app/ r,
    /app/** rwk,

    # Python installation and libraries
    /usr/ r,
    /usr/local/ r,
    /usr/local/** rix,

    # System libraries
    /lib/ r,
    /lib/** mr,
    /lib64/ r,
    /lib64/** mr,
    /usr/lib/ r,
    /usr/lib/** mr,

    # Dynamic linker cache
    /etc/ld.so.cache r,

    # Network access for Flask
    network inet,

    # Protect sensitive system files
    deny /etc/passwd r,
    deny /etc/shadow r,
    deny /var/** rwkl,

    # Restrict execution from system binary directories
    deny /bin/** x,
    deny /usr/bin/** x,

    # Restrict administrative capability
    deny capability sys_admin,
}

